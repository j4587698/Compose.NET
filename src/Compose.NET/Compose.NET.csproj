<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Compose.NET</RootNamespace>
    <AssemblyName>Compose.NET</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Compose.NET</PackageId>
    <Version>0.1.0</Version>
    <Authors>jx</Authors>
    <Description>A .NET implementation of the Compose specification parser, aligned with compose-go. Parses and loads Docker Compose YAML files into strongly-typed models with no Docker dependency.</Description>
    <PackageTags>docker;compose;yaml;parser;compose-spec;docker-compose</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/j4587698/Compose.NET</RepositoryUrl>
    <ProjectUrl>https://github.com/j4587698/Compose.NET</ProjectUrl>
    <Copyright>Copyright (c) 2026 jx</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compose.NET.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.zh-CN.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

  <!-- netstandard2.1 polyfills -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
  </ItemGroup>

</Project>
